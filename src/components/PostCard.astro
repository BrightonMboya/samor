---
import { Image } from 'astro:assets';
import { localePath, type Locale } from '../i18n/ui';
import { journalUi, postSlug, type Post } from '../data/journal';

interface Props {
  post: Post;
  locale: Locale;
  /** Heading level for the title, so the card fits the outline of the page it sits on. */
  as?: 'h2' | 'h3';
}
const { post, locale, as: Heading = 'h3' } = Astro.props;
const ui = journalUi[locale];
---

<li class="post-card">
  <a href={localePath(locale, `/journal/${postSlug(post)}`)}>
    <div class="photo">
      <Image src={post.data.hero} alt="" widths={[420, 840]} sizes="(max-width: 900px) 100vw, 420px" />
    </div>
    <p class="eyebrow muted">{post.data.category} · {ui.read(post.data.readMinutes)}</p>
    <Heading class="card-title">{post.data.title}</Heading>
    <p class="muted small">{post.data.description}</p>
  </a>
</li>

<style>
  a {
    display: grid;
    align-content: start;
    gap: 10px;
    text-decoration: none;
    color: inherit;
  }
  .photo {
    aspect-ratio: 420 / 260;
    border-radius: var(--radius-sm);
    margin-bottom: 8px;
  }
  .photo :global(img) {
    transition: scale 400ms cubic-bezier(0.2, 0, 0, 1);
  }
  .eyebrow {
    font-size: 11px;
  }
  .card-title {
    text-wrap: balance;
  }
  .small {
    font-size: 15px;
    line-height: 1.55;
  }
  @media (hover: hover) and (pointer: fine) {
    a:hover .card-title {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
    a:hover .photo :global(img) {
      scale: 1.03;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .photo :global(img) {
      transition: none;
    }
  }
</style>
