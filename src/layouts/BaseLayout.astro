---
import { Font, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultOg from '../assets/images/migration-walk.jpg';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { dir, localePath, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Path of this page without a locale prefix, e.g. "/itineraries/slow-safari". Used for hreflang and the language switch. */
  path: string;
  title?: string;
  description?: string;
  /** Photo for link previews (WhatsApp, X, iMessage…). Cropped to 1200×630; defaults to the home hero. */
  image?: ImageMetadata;
  ogType?: 'website' | 'article';
}

const { locale, path, title, description, image = defaultOg, ogType = 'website' } = Astro.props;
const t = useTranslations(locale);
const pageTitle = title ? `${title} · ${locale === 'ar' ? 'سَمُر' : 'Samur'}` : t('site.title');
const site = Astro.site ?? new URL('https://samursafaris.com');
const enUrl = new URL(localePath('en', path), site).href;
const arUrl = new URL(localePath('ar', path), site).href;
const pageUrl = locale === 'ar' ? arUrl : enUrl;
const pageDescription = description ?? t('site.description');
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, site).href;
---

<!doctype html>
<html lang={locale} dir={dir(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#1E4D36" />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="ar" href={arUrl} />
    <link rel="alternate" hreflang="x-default" href={arUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={locale === 'ar' ? 'سَمُر' : 'Samur'} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={locale === 'ar' ? 'ar_SA' : 'en_GB'} />
    <meta property="og:locale:alternate" content={locale === 'ar' ? 'en_GB' : 'ar_SA'} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogUrl} />
    <Font cssVariable="--font-poppins" preload />
    <Font cssVariable="--font-roboto-serif" />
    <Font cssVariable="--font-plex-arabic" preload={locale === 'ar'} />
  </head>
  <body>
    <a class="skip-link" href="#main">{locale === 'ar' ? 'انتقل إلى المحتوى' : 'Skip to content'}</a>
    <Header locale={locale} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
