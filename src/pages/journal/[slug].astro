---
import PostView from '../../views/PostView.astro';
import { getPosts, postSlug, type Post } from '../../data/journal';

export async function getStaticPaths() {
  const posts = await getPosts('ar');
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
---

<PostView locale="ar" post={post} />
