---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'legal'>;
}
const { locale, entry } = Astro.props;
const slug = entry.id.split('/').pop()!;
const { Content } = await render(entry);
---

<BaseLayout locale={locale} path={`/${slug}`} title={entry.data.title} description={entry.data.description}>
  <article class="section legal">
    <div class="container">
      <div class="inner">
        <h1 class="h1">{entry.data.title}</h1>
        {entry.data.updated && <p class="updated">{entry.data.updated}</p>}
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  /* One centred reading column; the title block is centred over it, the body stays aligned to its start edge. */
  .inner {
    max-width: 720px;
    margin-inline: auto;
  }
  .h1 {
    font-size: clamp(36px, 5vw, 52px);
    line-height: 1.12;
    text-align: center;
    text-wrap: balance;
  }
  .updated {
    text-align: center;
    margin-top: 16px;
    font-style: italic;
    color: var(--forest-82);
  }
  .prose {
    margin-top: 32px;
    font-size: 17px;
    line-height: 1.75;
    color: var(--forest-82);
  }
  .prose :global(> * + *) {
    margin-top: 1.1em;
  }
  .prose :global(h2) {
    margin-top: 2.2em;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--forest);
  }
  .prose :global(h3) {
    margin-top: 1.8em;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--forest);
  }
  .prose :global(strong) {
    color: var(--forest);
    font-weight: 600;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-inline-start: 1.3em;
  }
  .prose :global(ul) {
    list-style: disc;
  }
  .prose :global(ol) {
    list-style: decimal;
  }
  .prose :global(li + li) {
    margin-top: 0.5em;
  }
  .prose :global(li::marker) {
    color: var(--forest-45);
  }
  .prose :global(a) {
    color: var(--fire);
    text-underline-offset: 3px;
  }
</style>
